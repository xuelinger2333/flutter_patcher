{
  "schema": 1,
  "channel": "flutter_patcher",
  "events": "flutter_patcher/events",
  "methods": {
    "bootPayload": {"args": {"fingerprint": "String", "publicKeyBase64": "String"}, "returns": "Map? {transportVersion: int, attempt: String, and envelopeBytes: Uint8List (bytecode) | kind: libapp, assets: Map<String, Uint8List>, fonts: Map<String, List<Uint8List>> (so)}"},
    "backgroundPayload": {"args": {"fingerprint": "String", "publicKeyBase64": "String"}, "returns": "Map? {transportVersion: int, and the bootPayload fields of its kind; no attempt}"},
    "markBooting": {"args": {"attempt": "String?"}, "returns": "null"},
    "reportBootSuccess": {"args": {"attempt": "String?"}, "returns": "null"},
    "reportDartBootError": {"args": {"attempt": "String?", "message": "String", "quarantine": "bool?"}, "returns": "null"},
    "saveConfig": {"args": {"maxCrashCount": "int", "loaderFieldCandidates": "List<String>", "loaderFallbackHeuristic": "bool"}, "returns": "null"},
    "hostStrategy": {"args": {}, "returns": "String? (so | bytecode)"},
    "hostScope": {"args": {}, "returns": "Map<String, String>? {application_id, channel, flavor, version_code, abi, fingerprint, strategy}"},
    "checkSignedManifest": {"args": {"wire": "String"}, "returns": "Map {action: String, fresh: bool, patch_seq: String?}"},
    "applySignedManifest": {"args": {"wire": "String", "payload": "String? (path of the downloaded patch; null for a withdrawal)"}, "returns": "Map {action: String, ok: bool, error: String?, message: String?}"},
    "updatePublicationTrust": {"args": {"wire": "String"}, "returns": "Map {ok: true}"},
    "rollback": {"args": {}, "returns": "null"},
    "currentVersion": {"args": {}, "returns": "String?"},
    "lastBootDiagnostic": {"args": {}, "returns": "Map?"},
    "appVersionCode": {"args": {}, "returns": "int (-1 on failure)"},
    "deviceAbi": {"args": {}, "returns": "String (arm64-v8a | ios-arm64)"},
    "blacklist": {"args": {}, "returns": "List<Map>"},
    "clearBlacklist": {"args": {}, "returns": "null"}
  },
  "channel_errors": ["AUTH_UPDATE_REJECTED", "BYTECODE_REJECTED", "ROLLBACK_FAILED"],
  "apply_errors": ["INVALID_ARGS", "BLACKLISTED", "NETWORK", "MD5_MISMATCH", "SIGNATURE_INVALID", "UNSUPPORTED_ABI", "ASSET_PACKAGE_INVALID", "IO_ERROR", "UNKNOWN"],
  "boot_statuses": ["NO_PATCH", "PATCHED", "DROPPED_VERSION_CODE_MISMATCH", "DROPPED_MD5_MISMATCH", "DROPPED_META_CORRUPTED", "DROPPED_CIRCUIT_BREAKER", "HOOK_INSTALL_FAILED", "BYTECODE_UNSUPPORTED", "BYTECODE_BOOT_FAILED", "UNKNOWN"],
  "progress_phases": ["downloading", "verifying", "finalizing"]
}
